APP_NAME="TWSD Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://connect.twsd.me

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=twsd_connect
DB_USERNAME=twsd_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Hashing (Argon2id mandatory)
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

# Trusted proxies & CORS
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=https://connect.twsd.me

# Laravel Passport & OIDC Asymmetric Keys
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
OIDC_ISSUER=https://connect.twsd.me
OIDC_ACTIVE_KEY_ID=
OIDC_KEY_ROTATION_DAYS=90
OIDC_ID_TOKEN_TTL_SECONDS=3600
PASSPORT_ACCESS_TOKEN_TTL_MINUTES=15
PASSPORT_REFRESH_TOKEN_TTL_DAYS=30
PASSPORT_AUTH_CODE_TTL_MINUTES=5

# Web Installation Wizard (automatically set to false once twsd_installed.lock is created)
TWSD_INSTALLER_ENABLED=true

# Bootstrap Seed Credentials (never commit real passwords)
TWSD_SUPER_ADMIN_NAME="Platform Super Admin"
TWSD_SUPER_ADMIN_EMAIL=
TWSD_SUPER_ADMIN_PASSWORD=
TWSD_INITIAL_ORG_NAME="TWSD Enterprise"
TWSD_INITIAL_ORG_SLUG="twsd"
TWSD_INITIAL_ORG_ADMIN_EMAIL=
TWSD_INITIAL_ORG_ADMIN_PASSWORD=

# Provider Placeholders (Phase 6-7 configured via Admin UI)
FIREBASE_CREDENTIALS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
WHATSAPP_API_URL=https://api.whatsapp.webglit.com/api/create-message
WHATSAPP_APP_KEY=
WHATSAPP_AUTH_KEY=
