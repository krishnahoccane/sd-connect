# TWSD Connect — cPanel / Apache Root Protection & Public Rewrite
# Recommended: Point cPanel Domain DocumentRoot directly to /public.
# Fallback: If DocumentRoot points to public_html, deny sensitive files and route traffic into public/.

DirectoryIndex public/index.php

# Block direct access to sensitive environment, git, composer, artisan, and documentation files
<FilesMatch "(^\.env|^\.git|^\.htaccess|^artisan$|^composer\.(json|lock)$|^phpunit\.xml$|^Dockerfile$|^docker-compose\.yml$|\.md$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never expose internal application or dependency directories via HTTP
    RewriteRule ^(app|bootstrap|config|database|deploy|docker|resources|routes|scripts|storage|tests|vendor)(/|$) - [F,L,NC]
    # Allow /.well-known/* for OIDC Discovery & JWKS; deny other dotfiles
    RewriteRule ^\.(?!well-known(/|$)) - [F,L]

    # Route root and all non-public requests internally to public/
    RewriteRule ^$ public/index.php [L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
