{
  "name": "twsd/connect-iam",
  "type": "project",
  "description": "TWSD Connect — Enterprise Multi-Tenant SSO, OAuth 2.0 & OpenID Connect Identity Platform",
  "keywords": ["laravel", "iam", "sso", "oauth2", "oidc", "passport", "multi-tenant"],
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "firebase/php-jwt": "^6.10",
    "google/apiclient": "^2.18",
    "kreait/laravel-firebase": "^5.10",
    "laravel/framework": "^12.0",
    "laravel/passport": "^13.0",
    "laravel/tinker": "^2.10",
    "lcobucci/jwt": "^5.4",
    "phpseclib/phpseclib": "^3.0",
    "predis/predis": "^2.3"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.20",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
